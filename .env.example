# Copy to .env.local and fill in your own values.

# --- Database ---
MONGODB_URI=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Cloudinary (product image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- AI chat assistant ---
GEMINI_API_KEY=

# Models tried in order. If one is overloaded (503), retired (404) or out
# of quota (429) the next one is used automatically.
GEMINI_CHAT_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# Store name shown in the chat widget and used by the assistant prompt.
NEXT_PUBLIC_STORE_NAME=StrideX

# What the store sells, and the currency used in replies.
CHAT_PRODUCT_NOUN=shoes
CHAT_CURRENCY=₹

# Quota protection. The Gemini free tier allows only a few requests per
# model per day, so the endpoint is rate limited per IP and repeated
# questions are served from a short lived cache.
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=600000
CHAT_CACHE_TTL_MS=300000

# Email the assistant points customers to for order/support questions.
SUPPORT_EMAIL=
